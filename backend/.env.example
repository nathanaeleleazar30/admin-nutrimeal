# Konfigurasi Server Express
PORT=5000
NODE_ENV=development

# Konfigurasi Database MySQL / MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nutrimeal_db
DB_PORT=3306

# Konfigurasi CORS (URL Frontend Next.js)
FRONTEND_URL=http://localhost:3000

# Konfigurasi JWT Secret (Ganti dengan string acak panjang di produksi)
JWT_SECRET=ganti-dengan-secret-jwt-acak-minimal-32-karakter

# Konfigurasi Google OAuth (Opsional, untuk verifikasi resmi idToken di backend)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Konfigurasi Midtrans Core API (QRIS Dinamis)
# Dapatkan Server Key dari Midtrans Dashboard -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false
